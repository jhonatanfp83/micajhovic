# Copiar como backend/.env para desarrollo local (XAMPP).
# En la nube estas variables se configuran en el panel de Render, NO en el código.

# Base de datos
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=control_qr
DB_USER=root
DB_PASS=

# Conexión cifrada (true para Aiven u otra base en la nube)
DB_SSL=false
# Contenido del certificado CA de Aiven (una sola línea, saltos como \n)
DB_SSL_CA_CONTENT=

# Zona horaria de los registros de entrada y salida
APP_TIMEZONE=America/Bogota
