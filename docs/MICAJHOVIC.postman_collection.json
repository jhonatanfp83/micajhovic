{
  "info": {
    "name": "MICAJHOVIC API",
    "description": "Colección para probar la API de la app móvil. Cambiar base_url, correo y password en Variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login app - faltan datos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status error', () => pm.expect(pm.response.json().status).to.eql('error'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": []
        },
        "url": {
          "raw": "{{base_url}}/login_app.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login_app.php"
          ]
        }
      }
    },
    {
      "name": "2. Login app - credenciales malas",
